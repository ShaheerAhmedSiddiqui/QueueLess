<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#222831">
    <title>
        <%= title ? `${title} | QueueLess` : 'Student Portal | QueueLess' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <% if (typeof pageCss !=='undefined' && pageCss) { %>
        <link rel="stylesheet" href="<%= pageCss %>">
        <% } %>
</head>

<body class="dashboard-body">
    <div class="dashboard-shell">
        <%- include('../partials/sidebar-student') %>
            <div class="dashboard-main">
                <header class="dashboard-topbar">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Toggle navigation"><i
                            class="bi bi-list"></i></button>
                    <div class="topbar-heading"><span class="topbar-eyebrow">STUDENT PORTAL</span><strong>
                            <%= title %>
                        </strong></div>
                    <div class="topbar-actions">
                        <button class="icon-action" type="button" aria-label="Notifications" title="Notifications"><i
                                class="bi bi-bell"></i><span class="notification-dot"></span></button>
                        <div class="topbar-divider"></div>
                        <div class="user-menu"><span class="user-avatar">
                                <%= (student.fullName || 'Student' ).split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase() %></span><span class="user-menu-text"><strong><%= student.fullName %></strong><small>Student</small></span><i class="bi bi-chevron-down user-chevron"></i></div>
        </div>
      </header>
      <main class="dashboard-content">
        <% if (demoMode) { %><div class="demo-notice"><i class="bi bi-info-circle-fill"></i><span><strong>Preview mode:</strong> This page uses fictional sample data. Queue actions are not connected to a live backend.</span></div><% } %>
        <%- body %>
      </main>
    </div>
  </div>
  <div class="sidebar-backdrop" data-sidebar-close></div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script><script src="/js/student.js"></script>
  <% if (typeof pageScript !== ' undefined' && pageScript) { %>
                                    <script src="<%= pageScript %>"></script>
                                    <% } %>
</body>

</html>