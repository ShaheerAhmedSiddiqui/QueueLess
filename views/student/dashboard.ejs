<% layout('layouts/student') -%>
    <div class="page-intro d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <p class="page-kicker">SUNDAY, NOVEMBER 8, 2026</p>
            <h1>Good morning, <%=
                    student.fullName.split(' ')[0] %> <span class="wave">✦</span></h1><p class="page-subtitle">Here' s
                    what's happening with your campus services today.</p>
        </div><a class="btn btn-mint" href="/student/services<%= demoMode ? '?preview=1' : '' %>"><i
                class="bi bi-plus-lg me-2"></i>Join a queue</a>
    </div>
    <div class="row g-3 stat-grid mb-4">
        <div class="col-sm-6 col-xl-4">
            <article class="stat-card">
                <div class="stat-icon mint-icon"><i class="bi bi-ticket-perforated"></i></div>
                <div class="stat-label">Active queues</div>
                <div class="stat-value">01</div>
                <div class="stat-foot"><span class="stat-dot dot-mint"></span> You have one active token</div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-4">
            <article class="stat-card">
                <div class="stat-icon dark-icon"><i class="bi bi-check2-circle"></i></div>
                <div class="stat-label">Completed services</div>
                <div class="stat-value">08</div>
                <div class="stat-foot">Across all university offices</div>
            </article>
        </div>
        <div class="col-sm-6 col-xl-4">
            <article class="stat-card">
                <div class="stat-icon gray-icon"><i class="bi bi-buildings"></i></div>
                <div class="stat-label">Available services</div>
                <div class="stat-value">05 <small>of 06</small></div>
                <div class="stat-foot">One service currently unavailable</div>
            </article>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-xl-7">
            <section class="content-card h-100">
                <div class="card-heading">
                    <div><span class="section-kicker">YOUR CURRENT VISIT</span>
                        <h2>Active queue</h2>
                    </div><a class="text-link" href="/student/queue-status<%= demoMode ? '?preview=1' : '' %>">View
                        details <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="active-queue-panel">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div><span class="muted-label">EXAMINATION OFFICE</span>
                            <h3>Examination Office</h3>
                            <p><i class="bi bi-geo-alt me-1"></i>Counter 02 · Main campus</p>
                        </div><span class="status-badge status-waiting"> <span></span> Waiting</span>
                    </div>
                    <div class="active-token-row">
                        <div><span class="muted-label">YOUR TOKEN NUMBER</span>
                            <div class="active-token">EX-042</div>
                        </div>
                        <div class="queue-mini-stats">
                            <div><strong>03</strong><span>Position</span></div>
                            <div><strong>10 <small>min</small></strong><span>Est. wait</span></div>
                        </div>
                    </div>
                    <div class="queue-progress-label"><span>Queue progress</span><strong>2 people ahead</strong></div>
                    <div class="progress">
                        <div class="progress-bar" style="width:42%"></div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3"><small
                            class="text-muted"><i class="bi bi-clock me-1"></i>Joined today at 10:24 AM</small><a
                            class="btn btn-dark-soft btn-sm"
                            href="/student/queue-status<%= demoMode ? '?preview=1' : '' %>">Track queue <i
                                class="bi bi-arrow-right ms-1"></i></a></div>
                </div>
                <p class="sample-caption mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Illustrative queue information
                    for interface preview.</p>
            </section>
        </div>
        <div class="col-xl-5">
            <section class="content-card h-100">
                <div class="card-heading">
                    <div><span class="section-kicker">QUICK ACCESS</span>
                        <h2>Find a service</h2>
                    </div><a class="text-link" href="/student/services<%= demoMode ? '?preview=1' : '' %>">All
                        services</a>
                </div>
                <div class="quick-service-list">
                    <% services.slice(0,4).forEach(service=> { %><a class="quick-service"
                            href="/student/services<%= demoMode ? '?preview=1' : '' %>"><span
                                class="service-icon-small"><i class="bi <%= service.icon %>"></i></span><span
                                class="quick-service-copy"><strong>
                                    <%= service.name %>
                                </strong><small>
                                    <%= service.available ? `${service.queue} people waiting` : 'Currently unavailable'
                                        %>
                                </small></span><i class="bi bi-chevron-right quick-chevron"></i></a>
                        <% }) %>
                </div>
            </section>
        </div>
        <div class="col-12">
            <section class="content-card">
                <div class="card-heading">
                    <div><span class="section-kicker">YOUR ACTIVITY</span>
                        <h2>Recent queue history</h2>
                    </div><a class="text-link" href="/student/history<%= demoMode ? '?preview=1' : '' %>">View history
                        <i class="bi bi-arrow-up-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table ql-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Token</th>
                                <th>Service</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% history.slice(0,3).forEach(item=> { %><tr>
                                    <td><strong class="table-token">
                                            <%= item.token %>
                                        </strong></td>
                                    <td>
                                        <%= item.service %>
                                    </td>
                                    <td>
                                        <%= item.date %>
                                    </td>
                                    <td><span
                                            class="status-badge <%= item.status === 'Completed' ? 'status-completed' : 'status-cancelled' %>">
                                            <%= item.status %>
                                        </span></td>
                                    <td class="text-end">
                                        <%= item.duration %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>