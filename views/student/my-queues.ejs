
<% layout('layouts/student') -%>
<%
    const activeList = activeQueues || [];
    const pastList = history || [];
    const allQueues = [...activeList, ...pastList];

    const formatDate = (date) => {
        if (!date) return 'Not available';

        return new Date(date).toLocaleString([], {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    };

    const statusClass = (status) =>
        String(status || '').toLowerCase();
%>

<div class="page-intro">
    <p class="page-kicker">QUEUE OVERVIEW</p>
    <h1>My queues</h1>
    <p class="page-subtitle">
        Manage your active visits and review previous queue requests.
    </p>
</div>

<div class="content-card">
    <div class="card-heading flex-wrap">
        <div>
            <span class="section-kicker">QUEUE RECORDS</span>
            <h2>Your queue activity</h2>
        </div>

        <div class="table-toolbar">
            <div class="search-field compact-search">
                <i class="bi bi-search"></i>
                <input
                    type="search"
                    id="queueSearch"
                    class="form-control"
                    placeholder="Search token or service..."
                    aria-label="Search queues">
            </div>
        </div>
    </div>

    <ul class="nav nav-pills ql-tabs mb-3" id="queueTabs">
        <li class="nav-item">
            <button class="nav-link active" data-queue-filter="all">
                All queues <span><%= allQueues.length %></span>
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-queue-filter="active">
                Active <span><%= activeList.length %></span>
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-queue-filter="past">
                Past <span><%= pastList.length %></span>
            </button>
        </li>
    </ul>

    <div class="table-responsive">
        <table class="table ql-table align-middle" id="queuesTable">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Service</th>
                    <th>Date joined</th>
                    <th>Status</th>
                    <th>Wait time</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>
                <% activeList.forEach(queue => { %>
                    <tr
                        data-state="active"
                        data-search="<%= `${queue.token_number} ${queue.service_name}`.toLowerCase() %>">

                        <td>
                            <strong class="table-token">
                                <%= queue.token_number %>
                            </strong>
                        </td>

                        <td><%= queue.service_name %></td>

                        <td><%= formatDate(queue.joined_at) %></td>

                        <td>
                            <span class="status-badge status-<%= statusClass(queue.status) %>">
                                <%= queue.status.replace(/_/g, ' ') %>
                            </span>
                        </td>

                        <td>—</td>

                        <td class="text-end">
                            <a
                                class="table-action"
                                href="/student/queue-status?token=<%= encodeURIComponent(queue.token_number) %>">
                                View <i class="bi bi-arrow-up-right"></i>
                            </a>
                        </td>
                    </tr>
                <% }) %>

                <% pastList.forEach(queue => { %>
                    <tr
                        data-state="past"
                        data-search="<%= `${queue.token_number} ${queue.service_name}`.toLowerCase() %>">

                        <td>
                            <strong class="table-token">
                                <%= queue.token_number %>
                            </strong>
                        </td>

                        <td><%= queue.service_name %></td>

                        <td><%= formatDate(queue.joined_at) %></td>

                        <td>
                            <span class="status-badge status-<%= statusClass(queue.status) %>">
                                <%= queue.status.replace(/_/g, ' ') %>
                            </span>
                        </td>

                        <td>—</td>

                        <td class="text-end">
                            <span class="text-muted">—</span>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="empty-state <%= allQueues.length ? 'd-none' : '' %>" id="queuesEmpty">
        <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
        </div>
        <h3>No queues found</h3>
        <p>You have no queue records yet.</p>
    </div>
</div>
