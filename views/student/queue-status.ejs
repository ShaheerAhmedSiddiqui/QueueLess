
<% layout('layouts/student') -%>
<%
    const queue = activeQueue || {};
    const status = String(queue.status || 'WAITING');
    const statusClass = status.toLowerCase();
    const joinedTime = queue.joinedAt
        ? new Date(queue.joinedAt).toLocaleTimeString([], {
            hour: '2-digit',
            minute: '2-digit'
        })
        : 'Not available';
%>

<div class="page-intro d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <p class="page-kicker">QUEUE TRACKER</p>
        <h1>Your queue status</h1>
        <p class="page-subtitle">Keep an eye on your place in line while you wait.</p>
    </div>
    <span class="update-indicator"><span></span> Database queue record</span>
</div>

<div class="queue-status-layout">
    <section class="queue-focus-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <span class="muted-label">YOUR SERVICE</span>
                <h2><%= queue.serviceName || 'Service unavailable' %></h2>
            </div>
            <span class="status-badge status-<%= statusClass %>">
                <span></span> <%= status.replace(/_/g, ' ') %>
            </span>
        </div>

        <div class="queue-token-focus">
            <span class="muted-label">YOUR TOKEN NUMBER</span>
            <div class="queue-token-number"><%= queue.token || '—' %></div>
            <span class="token-caption">Keep this number handy when your turn is near.</span>
        </div>

        <div class="queue-position-grid">
            <div class="position-stat position-primary">
                <span>Your position</span>
                <strong><%= queue.position ?? '—' %></strong>
                <small>in the queue</small>
            </div>
            <div class="position-stat">
                <span>People ahead</span>
                <strong><%= queue.ahead ?? '—' %></strong>
                <small>before your turn</small>
            </div>
            <div class="position-stat">
                <span>Estimated wait</span>
                <strong>—</strong>
                <small>Not available yet</small>
            </div>
        </div>

        <div class="queue-progress-block">
            <strong>Queue information</strong>
            <p class="mt-2 mb-1">Joined: <%= joinedTime %></p>
            <p class="mb-0">Status is retrieved from the database.</p>
        </div>

        <p class="sample-caption mb-0">
            <i class="bi bi-info-circle me-1"></i>
            Queue information is loaded from your account's database record.
        </p>
    </section>

    <aside class="queue-side-column">
        <section class="content-card next-step-card">
            <span class="section-kicker">WHAT HAPPENS NEXT</span>
            <h3>Stay nearby</h3>
            <p>When your token is called, proceed to the assigned counter.</p>
        </section>

        <section class="help-card">
            <div class="help-card-icon">
                <i class="bi bi-question-circle"></i>
            </div>
            <h3>Need help?</h3>
            <p>If you have a question about your visit, contact the university service desk.</p>
            <a href="/contact" class="text-link">
                Contact support <i class="bi bi-arrow-up-right"></i>
            </a>
        </section>
    </aside>
</div>
