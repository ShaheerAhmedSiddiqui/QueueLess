
<% layout('layouts/student') -%>

<div class="page-intro">
    <p class="page-kicker">ACCOUNT SETTINGS</p>
    <h1>My profile</h1>
    <p class="page-subtitle">Manage your personal information and account security.</p>
</div>

<% if (typeof queryStatus !== 'undefined' && queryStatus === 'profile-updated') { %>
    <div class="alert alert-success" role="alert">Your profile was updated successfully.</div>
<% } %>

<% if (typeof queryStatus !== 'undefined' && queryStatus === 'password-updated') { %>
    <div class="alert alert-success" role="alert">Your password was changed successfully.</div>
<% } %>

<div class="row g-4">
    <div class="col-xl-4">
        <section class="content-card profile-summary-card">
            <div class="profile-avatar">
                <%= student.fullName.split(' ').map(part => part[0]).slice(0, 2).join('').toUpperCase() %>
            </div>
            <h2><%= student.fullName %></h2>
            <p><%= student.email %></p>
            <span class="role-chip">
                <i class="bi bi-mortarboard me-1"></i> Student account
            </span>
            <div class="profile-summary-divider"></div>
            <div class="profile-detail">
                <span>Student ID</span>
                <strong><%= student.studentId %></strong>
            </div>
            <div class="profile-detail">
                <span>Account role</span>
                <strong>Student</strong>
            </div>
            <div class="profile-detail">
                <span>Member since</span>
                <strong>September 2023</strong>
            </div>
        </section>
    </div>

    <div class="col-xl-8">
        <section class="content-card mb-4">
            <div class="card-heading">
                <div>
                    <span class="section-kicker">PERSONAL DETAILS</span>
                    <h2>Profile information</h2>
                </div>
                <span class="edit-note">
                    <i class="bi bi-pencil-square me-1"></i>Editable fields
                </span>
            </div>

            <form id="profileForm" action="/student/profile" method="POST" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="profileName">Full name</label>
                    <input
                        id="profileName"
                        name="fullName"
                        class="form-control"
                        value="<%= student.fullName %>"
                        maxlength="120"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="profileEmail">University email</label>
                    <input id="profileEmail" class="form-control" value="<%= student.email %>" disabled>
                    <div class="form-text">Email changes require account verification.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="profileStudentId">Student ID</label>
                    <input id="profileStudentId" class="form-control" value="<%= student.studentId %>" disabled>
                    <div class="form-text">Managed by the university.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="profileRole">Account role</label>
                    <input id="profileRole" class="form-control" value="Student" disabled>
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-mint" type="submit">
                        <i class="bi bi-check2 me-1"></i>Save changes
                    </button>
                </div>
            </form>
        </section>

        <section class="content-card">
            <div class="card-heading">
                <div>
                    <span class="section-kicker">ACCOUNT SECURITY</span>
                    <h2>Change password</h2>
                </div>
                <span class="security-icon">
                    <i class="bi bi-shield-lock"></i>
                </span>
            </div>

            <form id="passwordForm" action="/student/change-password" method="POST" class="row g-3">
                <div class="col-12">
                    <label for="currentPassword" class="form-label">Current password</label>
                    <input
                        type="password"
                        id="currentPassword"
                        name="currentPassword"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label for="newPassword" class="form-label">New password</label>
                    <input
                        type="password"
                        id="newPassword"
                        name="newPassword"
                        class="form-control"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label for="confirmNewPassword" class="form-label">Confirm new password</label>
                    <input
                        type="password"
                        id="confirmNewPassword"
                        name="confirmNewPassword"
                        class="form-control"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-dark-soft" type="submit">Update password</button>
                </div>
            </form>
        </section>
    </div>
</div>
