<% layout('layouts/student') -%>
    <div class="page-intro">
        <p class="page-kicker">ACCOUNT SETTINGS</p>
        <h1>My profile</h1>
        <p class="page-subtitle">Manage your personal information and account security.</p>
    </div>
    <div class="row g-4">
        <div class="col-xl-4">
            <section class="content-card profile-summary-card">
                <div class="profile-avatar">
                    <%= student.fullName.split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase() %></div><h2><%= student.fullName %></h2><p><%= student.email %></p><span class="role-chip"><i class="bi bi-mortarboard me-1"></i> Student account</span><div class="profile-summary-divider"></div><div class="profile-detail"><span>Student ID</span><strong><%= student.studentId %></strong></div><div class="profile-detail"><span>Account role</span><strong>Student</strong></div><div class="profile-detail"><span>Member since</span><strong>September 2023</strong></div></section></div>
<div class="col-xl-8"><section class="content-card mb-4"><div class="card-heading"><div><span class="section-kicker">PERSONAL DETAILS</span><h2>Profile information</h2></div><span class="edit-note"><i class="bi bi-pencil-square me-1"></i>Editable fields</span></div><form id="profileForm" class="row g-3" novalidate><div class="col-md-6"><label class="form-label" for="profileName">Full name</label><input id="profileName" name="fullName" class="form-control" value="<%= student.fullName %>" required></div><div class="col-md-6"><label class="form-label" for="profileEmail">University email</label><input id="profileEmail" class="form-control" value="<%= student.email %>" disabled><div class="form-text">Email changes require account verification.</div></div><div class="col-md-6"><label class="form-label" for="profileStudentId">Student ID</label><input id="profileStudentId" class="form-control" value="<%= student.studentId %>" disabled><div class="form-text">Managed by the university.</div></div><div class="col-md-6"><label class="form-label" for="profileRole">Account role</label><input id="profileRole" class="form-control" value="Student" disabled></div><div class="col-12 d-flex justify-content-end"><button class="btn btn-mint" type="submit"><i class="bi bi-check2 me-1"></i>Save changes</button></div><p class="sample-caption mb-0">Profile saving will be connected after the account API is implemented.</p></form></section>
<section class="content-card"><div class="card-heading"><div><span class="section-kicker">ACCOUNT SECURITY</span><h2>Change password</h2></div><span class="security-icon"><i class="bi bi-shield-lock"></i></span></div><form id="passwordForm" class="row g-3" novalidate><div class="col-12"><label for="currentPassword" class="form-label">Current password</label><input type="password" id="currentPassword" class="form-control" autocomplete="current-password" required></div><div class="col-md-6"><label for="newPassword" class="form-label">New password</label><input type="password" id="newPassword" class="form-control" minlength="8" autocomplete="new-password" required></div><div class="col-md-6"><label for="confirmNewPassword" class="form-label">Confirm new password</label><input type="password" id="confirmNewPassword" class="form-control" autocomplete="new-password" required></div><div class="col-12 d-flex justify-content-end"><button class="btn btn-dark-soft" type="submit">Update password</button></div><p class="sample-caption mb-0">Password changes are not submitted until the backend security endpoint is implemented.</p></form></section></div></div>