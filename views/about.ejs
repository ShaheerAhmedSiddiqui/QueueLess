<% layout('layouts/main') -%>
    <section class="page-hero">
        <div class="container"><span class="section-kicker">ABOUT QUEUELESS</span>
            <h1>University services,<br><span>without the long wait.</span></h1>
            <p>QueueLess is a virtual queue management concept designed to make everyday campus services more organized
                and convenient.</p>
        </div>
    </section>
    <section class="section-block">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6">
                    <h2 class="content-title">The problem we want to solve</h2>
                    <p class="body-copy">Students often spend valuable time standing in lines to access routine
                        university services. Unclear waiting times and crowded service areas can make simple visits
                        frustrating.</p>
                </div>
                <div class="col-lg-6">
                    <h2 class="content-title">A clearer way to wait</h2>
                    <p class="body-copy">QueueLess provides an online way to join a service queue, receive a token,
                        monitor queue progress, and visit the counter when called. Staff can manage the queue while
                        administrators oversee services and counters.</p>
                </div>
            </div>
        </div>
    </section>
    <section class="how-section">
        <div class="container">
            <div class="section-heading"><span class="section-kicker">BUILT AROUND PEOPLE</span>
                <h2>One system, three roles.</h2>
            </div>
            <div class="row g-3 mt-3">
                <div class="col-md-4">
                    <article class="service-card h-100">
                        <div class="service-icon"><i class="bi bi-mortarboard"></i></div>
                        <h3>Students</h3>
                        <p>Join queues, follow token progress, and review previous visits.</p>
                    </article>
                </div>
                <div class="col-md-4">
                    <article class="service-card h-100">
                        <div class="service-icon"><i class="bi bi-person-workspace"></i></div>
                        <h3>Staff</h3>
                        <p>Call the next token, manage service flow, and review queue activity.</p>
                    </article>
                </div>
                <div class="col-md-4">
                    <article class="service-card h-100">
                        <div class="service-icon"><i class="bi bi-shield-check"></i></div>
                        <h3>Administrators</h3>
                        <p>Manage users, university services, counters, and system oversight.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>