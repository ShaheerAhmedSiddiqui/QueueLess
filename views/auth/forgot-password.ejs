<% layout('layouts/auth') -%>
    <div class="auth-shell"><a class="navbar-brand brand-lockup" href="/"><span
                class="brand-mark">Q</span><span>Queue<span class="brand-accent">Less</span></span></a>
        <div class="auth-card">
            <div class="auth-heading"><span class="section-kicker">ACCOUNT RECOVERY</span>
                <h1>Forgot your password?</h1>
                <p>Enter your university email to request a password reset.</p>
            </div>
            <form class="needs-validation" novalidate data-demo-form>
                <div class="mb-3"><label class="form-label" for="email">University email</label><input
                        class="form-control" id="email" type="email" required placeholder="name@university.edu">
                    <div class="invalid-feedback">Enter a valid email address.</div>
                </div>
                <div class="form-feedback" data-form-feedback role="status"></div><button class="btn btn-mint w-100"
                    type="submit">Request reset link</button>
            </form>
            <p class="auth-switch"><a href="/login">Return to sign in</a></p>
            <p class="prototype-note">Password-reset email delivery is not connected yet.</p>
        </div><a class="back-home" href="/"><i class="bi bi-arrow-left"></i> Back to homepage</a>
    </div>