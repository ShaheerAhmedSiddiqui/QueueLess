<% layout('layouts/auth') -%>
    <div class="auth-shell"><a class="navbar-brand brand-lockup" href="/"><span
                class="brand-mark">Q</span><span>Queue<span class="brand-accent">Less</span></span></a>
        <div class="auth-card">
            <div class="auth-heading"><span class="section-kicker">NEW PASSWORD</span>
                <h1>Choose a new password</h1>
                <p>Use a strong password you do not use elsewhere.</p>
            </div>
            <form class="needs-validation" novalidate data-demo-form>
                <div class="mb-3"><label class="form-label" for="newPassword">New password</label><input
                        class="form-control" id="newPassword" type="password" minlength="8" required></div>
                <div class="mb-3"><label class="form-label" for="confirmPassword">Confirm new password</label><input
                        class="form-control" id="confirmPassword" type="password" minlength="8" required></div>
                <div class="form-feedback" data-form-feedback role="status"></div><button class="btn btn-mint w-100"
                    type="submit">Save new password</button>
            </form>
            <p class="prototype-note">A valid reset token and backend password update are required before this page can
                save changes.</p>
        </div><a class="back-home" href="/login"><i class="bi bi-arrow-left"></i> Back to sign in</a>
    </div>