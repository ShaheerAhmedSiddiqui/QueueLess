<aside class="student-sidebar" id="studentSidebar" aria-label="Student navigation">
    <div class="sidebar-brand"><a class="brand-lockup"
            href="/student/dashboard<%= demoMode ? '?preview=1' : '' %>"><span
                class="brand-mark">Q</span><span>Queue<span class="brand-accent">Less</span></span></a></div>
    <div class="sidebar-label">WORKSPACE</div>
    <nav class="sidebar-nav">
        <a class="sidebar-link <%= activePage === 'dashboard' ? 'active' : '' %>"
            href="/student/dashboard<%= demoMode ? '?preview=1' : '' %>"><i
                class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
        <a class="sidebar-link <%= activePage === 'services' ? 'active' : '' %>"
            href="/student/services<%= demoMode ? '?preview=1' : '' %>"><i class="bi bi-building"></i><span>Available
                Services</span></a>
        <a class="sidebar-link <%= activePage === 'queues' ? 'active' : '' %>"
            href="/student/my-queues<%= demoMode ? '?preview=1' : '' %>"><i class="bi bi-ticket-perforated"></i><span>My
                Queues</span>
            <% if (activeQueue) { %><span class="sidebar-count">1</span>
                <% } %>
        </a>
        <a class="sidebar-link <%= activePage === 'history' ? 'active' : '' %>"
            href="/student/history<%= demoMode ? '?preview=1' : '' %>"><i class="bi bi-clock-history"></i><span>Queue
                History</span></a>
    </nav>
    <div class="sidebar-label sidebar-label-spaced">ACCOUNT</div>
    <nav class="sidebar-nav">
        <a class="sidebar-link <%= activePage === 'profile' ? 'active' : '' %>"
            href="/student/profile<%= demoMode ? '?preview=1' : '' %>"><i class="bi bi-person-circle"></i><span>My
                Profile</span></a>
    </nav>
    <div class="sidebar-help">
        <div class="sidebar-help-icon"><i class="bi bi-headset"></i></div><strong>Need assistance?</strong>
        <p>Our support team is here to help.</p><a href="/contact">Contact support <i
                class="bi bi-arrow-up-right"></i></a>
    </div>
    <a class="sidebar-link sidebar-logout" href="/logout"><i class="bi bi-box-arrow-left"></i><span>Log out</span></a>
</aside>